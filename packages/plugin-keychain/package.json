{
  "name": "@angular-native/plugin-keychain",
  "version": "0.0.1",
  "description": "The keychain and the Android keystore, as an angular-native plugin.",
  "type": "module",
  "main": "src/public-api.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "types": "dist/public-api.d.ts",
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "angular",
    "native",
    "ios",
    "android",
    "rust",
    "no-webview",
    "angular-native",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angular-Native/angular-native.git",
    "directory": "packages/plugin-keychain"
  },
  "license": "MIT",
  "author": "Néstor García Bou",
  "homepage": "https://angular-native.github.io",
  "bugs": {
    "url": "https://github.com/Angular-Native/angular-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/public-api.js",
    "module": "dist/public-api.js"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "angularNative": {
    "module": "keychain",
    "entry": "src/public-api.ts",
    "ios": {
      "sources": "native/ios",
      "register": "AnKeychainPlugin",
      "plist": {
        "NSFaceIDUsageDescription": "To check it is you before showing what is stored."
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(BUNDLE_ID)"
        ]
      }
    },
    "android": {
      "sources": "native/android",
      "register": "dev.angularnative.plugins.KeychainPlugin",
      "manifest": {
        "uses-permission": [
          "android.permission.USE_BIOMETRIC"
        ],
        "uses-feature": {
          "android.hardware.fingerprint": false
        }
      }
    },
    "macos": {
      "sources": "native/macos",
      "register": "AnKeychainPlugin",
      "entitlements": {
        "keychain-access-groups": [
          "$(BUNDLE_ID)"
        ]
      }
    },
    "watchos": {
      "sources": "native/watchos",
      "register": "AnKeychainPlugin",
      "entitlements": {
        "keychain-access-groups": [
          "$(BUNDLE_ID)"
        ]
      }
    }
  }
}
