{
  "name": "@angular-native/plugin-geolocation",
  "version": "0.0.1",
  "description": "Where the device is — CLLocationManager and Android's LocationManager, as an angular-native plugin.",
  "type": "module",
  "main": "src/public-api.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "types": "dist/public-api.d.ts",
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "angular",
    "native",
    "ios",
    "android",
    "rust",
    "no-webview",
    "angular-native",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angular-Native/angular-native.git",
    "directory": "packages/plugin-geolocation"
  },
  "license": "MIT",
  "author": "Néstor García Bou",
  "homepage": "https://angular-native.github.io",
  "bugs": {
    "url": "https://github.com/Angular-Native/angular-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/public-api.js",
    "module": "dist/public-api.js"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "angularNative": {
    "module": "geolocation",
    "entry": "src/public-api.ts",
    "ios": {
      "sources": "native/apple",
      "register": "AnGeolocationPlugin",
      "plist": {
        "NSLocationWhenInUseUsageDescription": "To show you what is around you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "To keep following the route while the app is in the background.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "macos": {
      "sources": "native/apple",
      "register": "AnGeolocationPlugin",
      "plist": {
        "NSLocationUsageDescription": "To show you what is around you."
      },
      "entitlements": {
        "com.apple.security.personal-information.location": true
      }
    },
    "android": {
      "sources": "native/android",
      "register": "dev.angularnative.plugins.GeolocationPlugin",
      "manifest": {
        "uses-permission": [
          "android.permission.ACCESS_COARSE_LOCATION",
          "android.permission.ACCESS_FINE_LOCATION",
          "android.permission.ACCESS_BACKGROUND_LOCATION",
          "android.permission.FOREGROUND_SERVICE",
          "android.permission.FOREGROUND_SERVICE_LOCATION",
          "android.permission.POST_NOTIFICATIONS"
        ],
        "uses-feature": {
          "android.hardware.location": false
        },
        "service": {
          "dev.angularnative.plugins.GeolocationService": {
            "android:exported": "false",
            "android:foregroundServiceType": "location"
          }
        }
      }
    },
    "watchos": {
      "unsupported": "watchOS does have CoreLocation, but a watch app that wants a fix has to declare a background mode and hold a session open: that is a different feature with a different lifecycle, not the same call on a smaller screen. A watch app that needs a position should ask the paired phone for it."
    }
  }
}
