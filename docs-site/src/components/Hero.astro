---
/*
 * The splash page's opening screen, replacing Starlight's `Hero`.
 *
 * Centred and vertical rather than two columns. The claim this project makes is
 * one sentence long — the control on screen is the system's own — and a
 * sentence that short reads better with nothing beside it competing for the
 * first look. The code that backs the claim comes immediately after, in
 * `Signature.astro`, where it can be shown against what it turns into.
 *
 * Four things, in the order somebody needs them: what changed recently, the
 * claim, the two ways in, and the command that starts a project.
 *
 * Everything that is prose comes from the page's frontmatter, so the Spanish
 * page renders the same layout with its own words and nothing has to be
 * translated inside a component.
 */
import { LinkButton } from '@astrojs/starlight/components'

// Starlight's own heading id, which the skip link and the "back to top" anchor
// both point at. It is not exported from the package, so it is spelled out.
const PAGE_TITLE_ID = '_top'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero || {}
const { eyebrow, command, announce, announceLink } = data as {
  eyebrow?: string
  command?: string
  announce?: string
  announceLink?: string
}

// One box, one copy, however many lines the page put in it.
const commands = command?.trim().split('\n').map((line) => line.trim()) ?? []

const copyLabel = Astro.locals.t('expressiveCode.copyButtonTooltip')
const copiedLabel = Astro.locals.t('expressiveCode.copyButtonCopied')
---

<div class="an-hero not-content">
  <div class="an-hero__grid" aria-hidden="true">
    <span class="an-glint" data-axis="x" style="--at: 4.5rem;  --wait: 0s"></span>
    <span class="an-glint" data-axis="x" style="--at: 13.5rem; --wait: 3.1s"></span>
    <span class="an-glint" data-axis="y" style="--at: 22.5rem; --wait: 1.4s"></span>
    <span class="an-glint" data-axis="y" style="--at: 36rem;   --wait: 5.2s"></span>
  </div>

  {
    announce && (
      <a class="an-announce" href={announceLink ?? '/guide/quick-start/'}>
        <span class="an-announce__dot" aria-hidden="true" />
        {announce}
        <span class="an-announce__arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }

  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <div class="an-hero__tagline" set:html={tagline} />}

  {
    actions.length > 0 && (
      <div class="an-hero__actions">
        {actions.map(({ attrs = {}, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name} {...attrs}>
            {text}
          </LinkButton>
        ))}
      </div>
    )
  }

  {
    commands.length > 0 && (
      <div class="an-command">
        {commands.map((line) => (
          <Fragment>
            <span class="an-command__prompt" aria-hidden="true">
              $
            </span>
            <code>{line}</code>
          </Fragment>
        ))}
        <button
          class="an-command__copy"
          type="button"
          data-command={commands.join('\n')}
          data-copied={copiedLabel}
          aria-label={copyLabel}
          title={copyLabel}
        >
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
              d="M5.5 5.5h7v7h-7zM10.5 5.5v-2h-7v7h2"></path>
          </svg>
        </button>
      </div>
    )
  }

  {eyebrow && <p class="an-hero__eyebrow">{eyebrow}</p>}
</div>

<script>
  // Small enough to stay inline: the button copies the command and says so for
  // a moment.
  document.querySelectorAll<HTMLButtonElement>('.an-command__copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const command = button.dataset.command
      if (!command) return
      try {
        await navigator.clipboard.writeText(command)
      } catch {
        return
      }
      const previous = button.getAttribute('aria-label')
      button.classList.add('is-copied')
      button.setAttribute('aria-label', button.dataset.copied || 'Copied')
      window.setTimeout(() => {
        button.classList.remove('is-copied')
        if (previous) button.setAttribute('aria-label', previous)
      }, 1600)
    })
  })
</script>
