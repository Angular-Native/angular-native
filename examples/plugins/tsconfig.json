{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // `dom` is in for the types alone: Angular's .d.ts files reference Document,
    // Element and Event. At runtime none of the three exists.
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": false,
    "moduleDetection": "force",
    "outDir": "../../build/js/plugins",
    "rootDir": "../..",
    "paths": {
      "@angular-native/platform": ["../../packages/platform-native/src/public-api.ts"],
      "@angular-native/primitives": ["../../packages/primitives/src/public-api.ts"],
      "@angular-native/plugin-biometrics": ["../../packages/plugin-biometrics/src/public-api.ts"],
      "@angular-native/plugin-camera": ["../../packages/plugin-camera/src/public-api.ts"],
      "@angular-native/plugin-clipboard": ["../../packages/plugin-clipboard/src/public-api.ts"],
      "@angular-native/plugin-geolocation": ["../../packages/plugin-geolocation/src/public-api.ts"],
      "@angular-native/plugin-keychain": ["../../packages/plugin-keychain/src/public-api.ts"],
      "@angular-native/plugin-notifications": ["../../packages/plugin-notifications/src/public-api.ts"],
      "@angular-native/plugin-preferences": ["../../packages/plugin-preferences/src/public-api.ts"]
    },
    "types": []
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "compilationMode": "full"
  }
}
