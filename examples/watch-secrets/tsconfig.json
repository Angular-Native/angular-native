{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // `dom` is in for the types alone: Angular's .d.ts files reference Document,
    // Element and Event. At runtime none of the three exists.
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": false,
    "moduleDetection": "force",
    "outDir": "../../build/js/watch-secrets",
    "rootDir": "../..",
    "paths": {
      "@angular-native/platform": ["../../packages/platform-native/src/public-api.ts"],
      "@angular-native/primitives": ["../../packages/primitives/src/public-api.ts"],
      // The keychain and nothing else. `examples/secrets` also pulls in
      // biometrics, and that is exactly why it cannot be built for a watch.
      "@angular-native/plugin-keychain": ["../../packages/plugin-keychain/src/public-api.ts"]
    },
    "types": []
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "compilationMode": "full"
  }
}
