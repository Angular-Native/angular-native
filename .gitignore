target/
# No leading slash, so it holds at any depth: there is one at the root and
# another in `docs-site`, which brings its own Astro and shares nothing with the
# framework.
node_modules
.astro/
dist/
.DS_Store
*.xcuserdatad/
build/

# Android emulator and build artefacts
*.apk

# The Android dependencies: `scripts/fetch-android-deps.py` downloads them, and
# they are a dozen megabytes of third-party binaries that have no business
# living in the repository.
vendor/android/
