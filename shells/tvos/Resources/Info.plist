<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeTV</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.tv</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNativeTV</string>
    <key>CFBundleDisplayName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>17.0</string>
    <!--
      3 is the Apple TV. 1 and 2 are not listed here as well the way they are on
      iOS: a tvOS bundle does not run on a phone, and saying that it does only
      makes the error arrive later.
    -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>3</integer>
    </array>
    <!--
      No `LSRequiresIPhoneOS`, no `UILaunchScreen` and no
      `UISupportedInterfaceOrientations`: all three belong to the phone. A
      television does not rotate, and its launch screen is not a storyboard but
      the top layer's image, which is the asset catalogue's business.
    -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- The development server speaks plain HTTP to localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!--
      Without this the app installs and launches, but appears in the grid with no
      icon: tvOS's `CFBundleIcons` points at a layered icon and at the top shelf
      image, and both live in an asset catalogue compiled with `actool`. There is
      none here yet, so the key is deliberately left out rather than pointing at a
      name that does not exist. See docs/tvos.md.
    -->
</dict>
</plist>
