<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.angularnative"
    android:versionCode="1"
    android:versionName="1.0">

    <!--
      The version. A device never asks for it, which is why this manifest went
      without one for so long, but a store does: Google Play refuses a bundle
      whose versionCode it has already seen, and `bundletool` refuses one that
      has no versionCode at all — with "Version code not found in manifest",
      after everything else has already been built.

      versionCode is an integer nobody sees and it has to go up with every
      upload. versionName is the string people read, and Play does not care what
      it says.
    -->

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      What the `network` built-in module reads. It is an install-time
      permission: there is no dialog and nothing the person grants at run time,
      so without this line every call to `network.status()` would throw
      SecurityException. The module checks for it and answers with this very
      line rather than dying, but an app that ships without it has a module that
      only ever says no.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      What the `haptics` built-in module needs. Install-time as well, and the
      same arrangement: the module checks for it and answers with this line
      rather than throwing SecurityException at the first tap.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Package visibility. Since Android 11 an app cannot see which other apps
      are installed unless it says what it is looking for, and `resolveActivity`
      answers `null` for everything it cannot see. Without this the `files` and
      `share` modules would conclude that a device with a perfectly good
      document picker has none, and say so — which is worse than not asking, as
      it is a confident wrong answer.

      Only these two, and only because the two built-in modules ask them.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!--
      Without this the APK is the phone's and the watch treats it as such: the
      Play Store does not offer it for the watch and the system applies none of
      its form-factor rules. It is the declaration that turns an Android APK
      into a Wear OS APK, and that is why the manifest is a separate file and
      not a conditional line in the usual one.
    -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!--
      The crown. It is declared as not required because square Wear watches do
      not always have one, and an app that can only be scrolled with it should
      not refuse to install on the ones that do not: a finger still works.
    -->
    <uses-feature
        android:name="android.hardware.rotaryencoder.lowres"
        android:required="false" />

    <application
        android:label="AngularNative"
        android:theme="@style/Theme.AngularNative.Wear"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <!--
          That the app does not need a paired phone to work. Without this key,
          Wear OS assumes it is one half of a phone app and hides it from the
          launcher if it cannot find the other half.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />


        <!--
          How a file leaves the app.

          Since Android 7 handing another app a `file://` path throws
          `FileUriExposedException`, so the `share` module wraps what it sends in
          a `content://` URI from this provider. It is not exported and it grants
          permission per URI and per share: what crosses is the one file, to the
          one app the person picked, for as long as that app needs it.

          `@xml/an_file_paths` says which directories may be handed over, and it
          is only the two the `files` module owns.

          The authority is built from the application id rather than written
          out. A provider authority is unique across the whole device and not
          within the app, so two angular-native apps both claiming one fixed
          name cannot be installed side by side: the second one fails with
          INSTALL_FAILED_CONFLICTING_PROVIDER. `an` fills it in when it writes
          the manifest aapt2 sees, because renaming the manifest package
          rewrites the package and qualifies relative class names and leaves
          every attribute value exactly as it found it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.anfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/an_file_paths" />
        </provider>

        <!--
          singleTask, and not for the task semantics: it is what makes
          `onNewIntent` happen. With the default launch mode a VIEW intent
          reaching a running app builds a *second* MainActivity — a second
          engine, a second tree, and whatever the person had done gone — instead
          of handing the URL to the one already on screen. Wear OS runs the
          phone's `MainActivity`, so it is the same class and the same rule.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links. The receiving code is the phone's, because the activity
              is: `shells/android/java` is compiled into both APKs and it already
              reads the launch intent and answers `onNewIntent`. Only the filter
              was missing, and without it Android matches nothing and there is no
              error to read.

              A watch is not where somebody pastes a URL, but it is where `adb
              shell am start -a android.intent.action.VIEW -d ...` and a Wear
              notification's content intent land, and both are the same VIEW
              intent this filter answers.

              The scheme is the application id, the only spelling that cannot
              collide device-wide; `an` substitutes the placeholder when it
              writes the manifest aapt2 sees, exactly as it does on the phone.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
