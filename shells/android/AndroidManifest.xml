<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.angularnative"
    android:versionCode="1"
    android:versionName="1.0">

    <!--
      The version. A device never asks for it, which is why this manifest went
      without one for so long, but a store does: Google Play refuses a bundle
      whose versionCode it has already seen, and `bundletool` refuses one that
      has no versionCode at all — with "Version code not found in manifest",
      after everything else has already been built.

      versionCode is an integer nobody sees and it has to go up with every
      upload. versionName is the string people read, and Play does not care what
      it says.
    -->

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      What the `network` built-in module reads. It is an install-time
      permission: there is no dialog and nothing the person grants at run time,
      so without this line every call to `network.status()` would throw
      SecurityException. The module checks for it and answers with this very
      line rather than dying, but an app that ships without it has a module that
      only ever says no.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      What the `haptics` built-in module needs. Install-time as well, and the
      same arrangement: the module checks for it and answers with this line
      rather than throwing SecurityException at the first tap.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Package visibility. Since Android 11 an app cannot see which other apps
      are installed unless it says what it is looking for, and `resolveActivity`
      answers `null` for everything it cannot see. Without this the `files` and
      `share` modules would conclude that a device with a perfectly good
      document picker has none, and say so — which is worse than not asking, as
      it is a confident wrong answer.

      Only these two, and only because the two built-in modules ask them.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!--
      No action bar: the whole screen is drawn by the app, just as on iOS, and
      the layout already reserves the gap for the status bar.

      The theme is Material 3's, which comes with the Material library: the
      platform does not ship it. With `DeviceDefault` the controls came out with
      the look the manufacturer keeps up to date, which is not the same thing:
      the Material 3 components —the navigation bar, the buttons— are not in the
      platform and need their theme to be drawn properly.

      The concrete style lives in `res/values/styles.xml` and not here: the
      watch needs attributes of its own and the two themes are declared
      together.
    -->
    <!--
      Back through the API 33 dispatcher, which is what makes predictive back
      possible: without this line the system goes on calling the deprecated
      `onBackPressed` on 33..35, and on 36 it does neither — the opt-out was
      removed, so an app that never opted in simply loses back. `MainActivity`
      keeps the old override for 24..32.
    -->
    <application
        android:label="AngularNative"
        android:theme="@style/Theme.AngularNative"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <!--
          How a file leaves the app.

          Since Android 7 handing another app a `file://` path throws
          `FileUriExposedException`, so the `share` module wraps what it sends in
          a `content://` URI from this provider. It is not exported and it grants
          permission per URI and per share: what crosses is the one file, to the
          one app the person picked, for as long as that app needs it.

          `@xml/an_file_paths` says which directories may be handed over, and it
          is only the two the `files` module owns.

          The authority is built from the application id rather than written
          out. A provider authority is unique across the whole device and not
          within the app, so two angular-native apps both claiming one fixed
          name cannot be installed side by side: the second one fails with
          INSTALL_FAILED_CONFLICTING_PROVIDER. `an` fills it in when it writes
          the manifest aapt2 sees, because renaming the manifest package
          rewrites the package and qualifies relative class names and leaves
          every attribute value exactly as it found it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.anfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/an_file_paths" />
        </provider>

        <!--
          singleTask, and not for the task semantics: it is what makes
          `onNewIntent` happen. With the default launch mode a VIEW intent
          reaching a running app builds a *second* MainActivity — a second
          engine, a second tree, and whatever the person had done gone — instead
          of handing the URL to the one already on screen.
        -->
        <!--
          adjustResize is for API 24 to 29 and for nothing above them.

          `WindowInsets.Type.ime()` is API 30, so on those levels the shell has
          to measure the keyboard rather than be told about it, and it can only
          measure something the platform actually did. Left unspecified the
          platform chooses per window between panning and resizing, and which
          one it chose is not something the app can read back. Asked for
          explicitly, the window shrinks and `AnHost.installLegacyKeyboard`
          sees the container end where the keyboard starts.

          It is inert from 30 up, where the flag is deprecated and ignored for
          a window that called `setDecorFitsSystemWindows(false)` — which
          `AnHost` does, on exactly those levels.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links, the half that needs no server.

              The scheme is the application id, which is the only spelling that
              cannot collide: a scheme is claimed device-wide and two apps
              claiming "myapp" leave Android showing a chooser. So
              `<applicationId>://ship/2` opens the app on that route, and `an`
              substitutes the placeholder when it writes the manifest aapt2
              sees, exactly as it does for the FileProvider's authority.

              BROWSABLE is what lets a link in another app —a browser, a
              message— start this one. DEFAULT is what lets an implicit VIEW
              intent resolve to this activity at all; without it the filter
              matches nothing and there is no error to read.

              An App Link on a real https:// address is a second filter, with
              android:autoVerify="true" and an assetlinks.json served from the
              site. It is not written here because nothing can write it for you:
              the site is yours. The guide says what it looks like.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
