<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.angularnative">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      No action bar: the whole screen is drawn by the app, just as on iOS, and
      the layout already reserves the gap for the status bar.

      The theme is Material 3's, which comes with the Material library: the
      platform does not ship it. With `DeviceDefault` the controls came out with
      the look the manufacturer keeps up to date, which is not the same thing:
      the Material 3 components —the navigation bar, the buttons— are not in the
      platform and need their theme to be drawn properly.

      The concrete style lives in `res/values/styles.xml` and not here: the
      watch needs attributes of its own and the two themes are declared
      together.
    -->
    <application
        android:label="AngularNative"
        android:theme="@style/Theme.AngularNative"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
