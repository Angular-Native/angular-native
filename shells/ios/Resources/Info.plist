<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNative</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNative</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>17.0</string>
    <!-- The development server speaks plain HTTP to localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <!--
      Without this the app declares itself for iPhone only, and an iPad runs it
      in a scaled 320x480 compatibility window: everything looks enormous, and on
      presenting any system controller —a dialog— iOS drops the scaling and the
      content appears tiny in a corner.
    -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
	<key>NSCameraUsageDescription</key>
	<string>To take a photograph and to read a barcode.</string>
    <!--
      Deep links, the half that needs no server.

      The scheme is the bundle identifier, which is what Apple recommends and
      the only spelling that cannot collide: a scheme is claimed device-wide,
      and two apps claiming "myapp" end up with iOS picking one of them. So
      `dev.angularnative.playground://ship/2` opens this app on that route, and
      `an add ios` writes the same line with the project's own identifier in it.

      A universal link —a real https:// address that opens the app instead of
      Safari— is not declared here. It needs the associated-domains entitlement
      and an apple-app-site-association file served from the site, neither of
      which anything can write for you. The guide says what to add.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>dev.angularnative.playground</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dev.angularnative.playground</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
