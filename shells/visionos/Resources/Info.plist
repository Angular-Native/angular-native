<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeVision</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.vision</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNativeVision</string>
    <key>CFBundleDisplayName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>1.0</string>
    <!-- 7 is the headset. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>7</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!--
      The scene-based lifecycle, which on visionOS is not optional.

      On iOS an app can still come into being the old way: the delegate creates a
      window the size of the screen and that is that. Here there is no screen
      —`UIScreen` is marked `API_UNAVAILABLE(visionos)`—, so the window can only
      come out of a `UIWindowScene`, and the system only creates one if this
      manifest declares who is going to handle it.

      `SceneDelegate` is the Objective-C name, the one `@objc` gives the Swift
      class. Were they not to match, the scene would connect, nobody would create
      the window and the app would start up black without a single error.
    -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <!--
          One window and not several. The node tree has one root and one
          viewport: two scenes would be two roots, and that has not been built.
        -->
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <!-- The development server speaks plain HTTP to localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
