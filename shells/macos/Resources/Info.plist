<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeMac</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.mac</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!--
      Without this the app starts with no icon in the Dock and unable to bring
      itself to the front: it looks like a window that will not take the focus
      and a menu that never appears.
    -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!--
      The text the system shows when asking for the location. Without this key,
      `<an-map-view [showsUser]="true">` neither fails nor warns: the permission
      is denied on its own and the blue dot never appears. With it, the system
      dialog comes up, which is what any Mac app would do.
    -->
    <key>NSLocationUsageDescription</key>
    <string>To show where you are on the map.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>To show where you are on the map.</string>
    <!-- The development server speaks plain HTTP to localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!--
      Deep links, the half that needs no server.

      The scheme is the bundle identifier, and on the Mac that identifier is the
      project's with `.mac` on the end: one project builds for the phone and for
      the desktop, both bundles can be installed on the same machine, and a
      scheme is claimed device-wide. Were the two to share one, LaunchServices
      would pick whichever it saw last. So
      `dev.angularnative.playground.mac://ship/2` opens this app on that route,
      and `an add macos` writes the same three lines with the project's own
      identifier in them.

      A universal link —a real https:// address that opens the app instead of
      Safari— is not declared here. It needs the associated-domains entitlement
      and an apple-app-site-association file served from the site, neither of
      which anything can write for you. The guide says what to add.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>dev.angularnative.playground.mac</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dev.angularnative.playground.mac</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
