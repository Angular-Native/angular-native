<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeMac</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.mac</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!--
      Sin esto la app arranca sin icono en el Dock y sin poder hacerse frontal:
      se ve como una ventana que no coge el foco y un menú que no aparece.
    -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!--
      El texto que enseña el sistema al pedir la ubicación. Sin esta clave,
      `<an-map-view [showsUser]="true">` no falla ni avisa: el permiso se
      deniega solo y el punto azul no sale nunca. Con ella sale el diálogo del
      sistema, que es lo que haría cualquier app de Mac.
    -->
    <key>NSLocationUsageDescription</key>
    <string>Para enseñar dónde estás en el mapa.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Para enseñar dónde estás en el mapa.</string>
    <!-- El servidor de desarrollo habla HTTP plano contra localhost. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
