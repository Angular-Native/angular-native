<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.watchkitapp</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleDisplayName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>11.0</string>
    <!--
      App de reloj independiente, sin app de iPhone que la acompañe. Es lo que
      distingue a un bundle de watchOS 7 en adelante del viejo par
      "WatchKit App + WatchKit Extension": sin esta clave el simulador instala
      el bundle y luego no encuentra nada que lanzar.
    -->
    <key>WKApplication</key>
    <true/>
    <key>WKWatchOnly</key>
    <true/>
    <!-- 4 es el reloj. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>4</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
