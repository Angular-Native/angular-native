<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.watchkitapp</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleDisplayName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>11.0</string>
    <!--
      A standalone watch app, with no iPhone app alongside it. It is what tells a
      watchOS 7 and later bundle from the old "WatchKit App + WatchKit Extension"
      pair: without this key the simulator installs the bundle and then finds
      nothing to launch.
    -->
    <key>WKApplication</key>
    <true/>
    <key>WKWatchOnly</key>
    <true/>
    <!-- 4 is the watch. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>4</integer>
    </array>
    <!--
      No CFBundleURLTypes, and that is a decision rather than an omission.

      Every other Apple family here declares its deep-link scheme and is opened
      by it. A watch is not: there is no public call on watchOS that opens a
      third-party app by a custom scheme — `WKApplication.openSystemURL(_:)`
      takes Apple's own and turns down everything else — and the block was tried
      here, with the scheme declared and the app installed and running, to see
      whether the system would nonetheless deliver: it answers
      `LSApplicationWorkspaceErrorDomain error 115`, which is nothing claimed it.
      A declaration nothing reads is worse than none, because it reads as wiring.

      The watch is reached instead by its own complication's `widgetURL` and by a
      universal link arriving as an `NSUserActivity`, and both are wired in
      `Sources/App.swift`, which is where the whole of it is written down.
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
