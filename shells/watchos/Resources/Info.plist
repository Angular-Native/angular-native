<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleIdentifier</key>
    <string>dev.angularnative.playground.watchkitapp</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AngularNativeWatch</string>
    <key>CFBundleDisplayName</key>
    <string>angular-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>11.0</string>
    <!--
      A standalone watch app, with no iPhone app alongside it. It is what tells a
      watchOS 7 and later bundle from the old "WatchKit App + WatchKit Extension"
      pair: without this key the simulator installs the bundle and then finds
      nothing to launch.
    -->
    <key>WKApplication</key>
    <true/>
    <key>WKWatchOnly</key>
    <true/>
    <!-- 4 is the watch. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>4</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
